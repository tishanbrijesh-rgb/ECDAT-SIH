# Local Python development may use SQLite; Compose sets its own PostgreSQL URL.
DATABASE_URL=sqlite:///./ecdat.db
# Compose: generate a random 64-character hexadecimal password (URL-safe).
ECDAT_DB_PASSWORD=
SCANNER_PATH=./scanner
ECDAT_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
ECDAT_ALLOWED_SCAN_ROOTS=
ECDAT_ALLOW_ROLE_HEADER=false
# Set distinct account passwords (16+ characters) and a random secret (32+).
ECDAT_USERS_JSON=
ECDAT_TOKEN_SECRET=
# Supervised API scans: one active worker per server process (run one API worker).
ECDAT_SCAN_TIMEOUT_SECONDS=300
ECDAT_MAX_FILE_BYTES=8388608
ECDAT_MAX_SCAN_FILES=100000
