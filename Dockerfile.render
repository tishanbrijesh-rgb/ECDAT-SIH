FROM node:22-alpine AS dashboard-build
WORKDIR /dashboard
COPY dashboard/package.json dashboard/package-lock.json ./
RUN npm ci
COPY dashboard/ ./
ENV VITE_API_URL=""
RUN npm run build

FROM python:3.11-slim-bookworm@sha256:528257d48c1da0dcecc2e725d1ae34498d60c965f1241e39cd6a85a8859bdf84
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /app
COPY backend/requirements.lock ./backend/requirements.lock
RUN pip install --no-cache-dir --require-hashes -r backend/requirements.lock
RUN groupadd --gid 10001 ecdat && useradd --uid 10001 --gid ecdat --no-create-home --shell /usr/sbin/nologin ecdat
COPY --chown=10001:10001 backend/ /app/backend/
COPY --chown=10001:10001 scanner/ /app/scanner/
COPY --chown=10001:10001 test-repo/ /app/test-repo/
COPY --chown=10001:10001 alembic.ini /app/alembic.ini
COPY --chown=10001:10001 alembic/ /app/alembic/
COPY --from=dashboard-build --chown=10001:10001 /dashboard/dist/ /app/dashboard-dist/
USER 10001:10001
CMD ["sh", "-c", "alembic upgrade head && exec uvicorn backend.render_app:app --host 0.0.0.0 --port ${PORT:-10000}"]
